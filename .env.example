# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# Claude로 대화하려면 Anthropic API 키를 넣으세요. 비워두면 간단한 대화 모드로 동작합니다.
ANTHROPIC_API_KEY=

# Postgres 주소 (Supabase → Connect → Transaction pooler). 비워두면 내장 DB(PGlite)를 ./data 에 만들어 씁니다.
DATABASE_URL=

# 선택
# PORT=8787
# CLAUDE_MODEL=claude-opus-5-5
# AI_DAILY_LIMIT=40        # 사용자 1명이 하루에 받을 수 있는 AI 답변 수 (넘으면 내장 답변으로 대화)
